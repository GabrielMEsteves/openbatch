# Managed by OpenBatch lab. Dedicated research cluster; not an existing HPC cluster.
ClusterName={{ slurm_lab_cluster }}
SlurmctldHost={{ hostvars[groups['lab_controller'][0]].ansible_hostname }}({{ hostvars[groups['lab_controller'][0]].ansible_host }})
SlurmUser=slurm
SlurmdUser=root
SlurmctldPort=6817
SlurmdPort=6818
SrunPortRange=60001-60020
AuthType=auth/munge
StateSaveLocation=/var/lib/slurm/slurmctld
SlurmdSpoolDir=/var/lib/slurm/slurmd
SlurmctldPidFile=/run/slurmctld/slurmctld.pid
SlurmdPidFile=/run/slurmd.pid
SlurmctldLogFile=/var/log/slurm/slurmctld.log
SlurmdLogFile=/var/log/slurm/slurmd.log
SchedulerType=sched/backfill
SelectType=select/cons_tres
SelectTypeParameters=CR_Core_Memory
ProctrackType=proctrack/cgroup
TaskPlugin=task/cgroup,task/affinity
JobAcctGatherType=jobacct_gather/cgroup
JobAcctGatherFrequency=5
AccountingStorageType=accounting_storage/slurmdbd
AccountingStorageHost={{ hostvars[groups['lab_controller'][0]].ansible_host }}
AccountingStoragePort=6819
AccountingStorageEnforce=associations
Epilog=/usr/local/lib/openbatch/slurm-epilog.py
ReturnToService=2
SlurmctldTimeout=120
SlurmdTimeout=300
MinJobAge=86400
KillWait=30
{% for worker in groups['lab_workers'] %}
NodeName={{ worker }} NodeAddr={{ hostvars[worker].ansible_host }} NodeHostname={{ hostvars[worker].ansible_hostname }} {{ hostvars[worker].slurm_lab_hardware.stdout_lines[0] | regex_replace('^NodeName=[^ ]+ +', '') | regex_replace('RealMemory=[0-9]+', 'RealMemory=' ~ ([((hostvars[worker].ansible_memtotal_mb | int) * 0.85) | int, (hostvars[worker].ansible_memtotal_mb | int) - 1024] | min)) }} State=UNKNOWN
{% endfor %}
PartitionName={{ slurm_lab_partition }} Nodes={{ groups['lab_workers'] | join(',') }} Default=YES MaxTime=01:00:00 State=UP OverSubscribe=NO
