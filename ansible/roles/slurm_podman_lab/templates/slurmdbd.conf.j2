# Managed by OpenBatch lab. Contains a runtime secret, mode 0600.
AuthType=auth/munge
DbdHost={{ ansible_hostname }}
DbdAddr={{ ansible_host }}
DbdPort=6819
SlurmUser=slurm
LogFile=/var/log/slurm/slurmdbd.log
PidFile=/run/slurmdbd/slurmdbd.pid
StorageType=accounting_storage/mysql
StorageHost=localhost
StorageUser=openbatch_slurm
StoragePass={{ slurm_lab_db_secret.content | b64decode | trim }}
StorageLoc=openbatch_slurm
