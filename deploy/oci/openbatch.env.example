# Reference for GitHub Environment `production`; deploy generates the files.
# Secret (required): generate with `openssl rand -hex 32`.
JWT_SECRET=REPLACE_WITH_64_HEXADECIMAL_CHARACTERS
# Optional for initial container deployment; required for SSH cluster login/jobs.
# Leave empty until the Slurm node and its SSH credentials have been provisioned.
SLURM_SSH_HOST=
# Optional environment variables:
JWT_EXPIRES_IN=1h
CORS_ORIGIN=
UPLOAD_MAX_SIZE_MB=50
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=8081
# Optional environment variable, used as the deployment link in GitHub:
APP_URL=https://openbatch.example.com
# Repository variable (not environment-scoped): amd64 or arm64.
OCI_ARCH=arm64
# GHCR authentication uses the automatic GITHUB_TOKEN; no PAT is required.
# SSH files stay on the VM: ~openbatch-runner/.local/share/openbatch/ssh/
# Place verified known_hosts and one <linux-user>.key per cluster user there.
