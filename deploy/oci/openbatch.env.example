NODE_ENV=production
HOST=127.0.0.1
PORT=8080
JWT_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32
JWT_EXPIRES_IN=1h
ENABLE_DEV_LOGIN=false
CORS_ORIGIN=
UPLOAD_MAX_SIZE_MB=50
OPENBATCH_JOB_STORE=/var/lib/openbatch/podman-jobs
# Native installation: leave SSH unset to use local PAM, users and Slurm.
# SLURM_SSH_HOST=
