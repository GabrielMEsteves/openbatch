NODE_ENV=production
PORT=8080
FRONTEND_PORT=80

# Use uma chave aleatoria com pelo menos 32 caracteres em producao.
JWT_SECRET=altere-esta-chave-por-uma-chave-segura
JWT_EXPIRES_IN=1h

# Login administrativo apenas para desenvolvimento e demonstracao.
ENABLE_DEV_LOGIN=false
ADMIN_PASSWORD=

# Vazio em producao quando frontend e backend usam a mesma origem via Nginx.
CORS_ORIGIN=
UPLOAD_MAX_SIZE_MB=50
