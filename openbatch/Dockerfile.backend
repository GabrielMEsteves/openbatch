# syntax=docker/dockerfile:1

FROM node:22-bookworm-slim AS dependencies

WORKDIR /app

# node-pty e node-linux-pam possuem extensoes nativas compiladas pelo node-gyp.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        g++ \
        libpam0g-dev \
        make \
        python3 \
    && rm -rf /var/lib/apt/lists/*

COPY backend/package.json backend/package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund

FROM node:22-bookworm-slim AS runtime

ENV NODE_ENV=production \
    PORT=8080

WORKDIR /app

# Dependencias utilizadas em tempo de execucao pelo PAM, terminal, upload e
# futura comunicacao SSH com o no mestre. Compiladores ficam fora desta etapa.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        clamav \
        libpam-modules \
        libpam-runtime \
        openssh-client \
        tini \
        unzip \
        util-linux \
    && rm -rf /var/lib/apt/lists/*

COPY --from=dependencies /app/node_modules ./node_modules
COPY server.js ./server.js

# O backend atual precisa iniciar como root para PAM, su/runuser e troca de
# UID/GID. A migracao dessas operacoes para SSH permitira remover esse requisito.
USER root

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD node -e "fetch('http://127.0.0.1:8080/api/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "server.js"]
